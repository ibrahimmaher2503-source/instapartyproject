APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instaparty
DB_USERNAME=instaparty
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# For local dev without a running queue worker, use: QUEUE_CONNECTION=sync
BOOKING_VENDOR_REVIEW_EXPIRY_ENABLED=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Misr credentials are supplied outside Git. 2=test, 1=production.
SMS_MISR_USERNAME=
SMS_MISR_PASSWORD=
SMS_MISR_SENDER=
SMS_MISR_ENVIRONMENT=2
SMS_MISR_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set to "public" to use local storage when S3/MinIO is not configured (local dev only).
# Leave blank (or omit) when AWS credentials or a MinIO endpoint are configured.
MEDIA_DISK_PUBLIC=

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# E2E testing (Playwright / global.setup.ts)
E2E_ADMIN_EMAIL=admin@instaparty.test
E2E_ADMIN_PASSWORD=
SCOUT_QUEUE=true

FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=
OTP_SEND_ON_REGISTRATION=false
CATALOG_DIGITAL_SERVICES_ENABLED=false
SETTLEMENT_REFUND_SLA_DAYS=5
