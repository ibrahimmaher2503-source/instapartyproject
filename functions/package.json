{
  "name": "instaparty-chat-functions",
  "version": "1.0.0",
  "description": "Firestore chat moderation + identity bridge Cloud Functions for InstaParty",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions:chat",
    "test": "vitest run test/contactPatterns.test.ts",
    "test:rules": "vitest run test/rules.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "private": true
}
