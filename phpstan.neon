includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 0
    reportUnmatchedIgnoredErrors: false
    stubFiles:
        - phpstan/stubs/filament-macroable.stub
    paths:
        - app
        - database

    # Direct wallet balance-write guard:
    # PHPStan has no custom rule for this yet (out of scope for Phase 1).
    # The architectural enforcement gate lives in:
    #   tests/Architecture/NoDirectWalletBalanceWritesTest.php
    # Any code outside EloquentWalletRepository::applyProjection() that calls
    # DB::table('wallets')->update/increment/decrement with balance_minor or
    # pending_withdrawal_minor will fail the CI architecture step.

    # Tests are validated by Pest, not PHPStan — Pest's $this magic is hostile to static analysis at level 8
    excludePaths:
        - app/Filament
        - app/Http/Controllers/Auth (?)
        - app/Modules/*/Filament/**/*
        - app/Console/Commands/SetupDevEnvironmentCommand.php
        - database/migrations/*activity_log* (?)

    ignoreErrors:
        # Eloquent dynamic attribute access on models — PHPStan can't infer columns
        -
            message: '#Access to an undefined property .+::\$(id|public_id|name|created_at|updated_at|deleted_at|.+_id|.+_at)\.#'
            path: app/*
        # Eloquent cast columns not visible to PHPStan static analysis
        -
            message: '#Access to an undefined property .+::\$(product_type|status|hold_type|stock_quantity|is_perishable|is_made_to_order|lead_time_hours|customization_fields|requires_electricity|requires_outdoor_space|default_rental_duration_hours|setup_time_minutes|teardown_time_minutes|security_deposit_minor|security_deposit_currency|minimum_space_sqm|delivery_method|has_expiry|expiry_days_after_purchase|is_refundable_after_delivery|redemption_url_template|base_price_minor|base_price_currency|quantity|reserved_starts_at|reserved_ends_at|expires_at)\.#'
            path: app/*
        # Communication module — third-party gateway packages (FCM, Vonage, Mailchimp) not installed in Phase 1
        -
            message: '#(unknown class|invalid type|not found) (Kreait|Vonage|MailchimpMarketing|kreait|vonage|mailchimp)#'
            path: app/Modules/Communication/Infrastructure/Gateways/*
        -
            message: '#(Call to|Access to property) .+ on an unknown class (Kreait|Vonage|MailchimpMarketing)#'
            path: app/Modules/Communication/Infrastructure/Gateways/*
        -
            message: '#Instantiated class Vonage#'
            path: app/Modules/Communication/Infrastructure/Gateways/*
        # Communication module — Eloquent generic type annotations — standard Larastan limitation
        -
            message: '#(return type with|has parameter .+ with) generic (class|interface|trait) (Illuminate\\Database\\Eloquent\\|Illuminate\\Support\\|Illuminate\\Contracts\\).+#'
            path: app/Modules/Communication/*
        # Communication module — seeder/DTO/FormRequest loose array types are intentional
        -
            message: '#(return type has|parameter \$variables with) no value type specified in iterable type array#'
            path: app/Modules/Communication/*
        # Communication module — Eloquent model dynamic property access on fillable columns
        -
            message: '#Access to an undefined property App\\Modules\\Communication\\.+::\$(channel|audience|status|locale|context|provider|provider_ref|reference_type|reference_id|error_message|body|subject|variables|is_active|is_enabled|quiet_hours_start|quiet_hours_end|timezone|event_key|event_category|user_id|notification_template_id)\.#'
            path: app/Modules/Communication/*
        # Communication listeners — event object is a domain event from another module; properties are runtime-only
        -
            message: '#Access to an undefined property object::\$.+\.#'
            path: app/Modules/Communication/Application/Listeners/*
        # Communication DispatchNotificationAction — array<string,mixed> context is intentional loose type
        -
            message: '#has parameter \$context with no value type specified in iterable type array#'
            path: app/Modules/Communication/*
        -
            message: '#return type has no value type specified in iterable type array#'
            path: app/Modules/Communication/Application/Actions/DispatchNotificationAction.php
        # Identity User model preferred_locale is a runtime string column
        -
            message: '#Access to an undefined property App\\Modules\\Identity\\Domain\\Models\\User::\$preferred_locale\.#'
            path: app/Modules/Communication/*
        # Eloquent dynamic attribute access via JsonResource magic __get — model properties not visible to PHPStan
        -
            message: '#Access to an undefined property .+::\$(rentalDetail|saleDetail|digitalDetail|is_featured|base_price_minor|base_price_currency|category_id|short_description)\.#'
            path: app/Modules/Catalog/Http/Resources/*
        # spatie/laravel-translatable getTranslation() is injected via trait — not visible to PHPStan on JsonResource
        -
            message: '#Call to an undefined method .+::getTranslation\(\)\.#'
            path: app/Modules/Catalog/Http/Resources/*
        # match on Eloquent cast enum returns mixed at PHPStan level 8 without @property
        -
            message: '#Match expression does not handle remaining value: mixed#'
            path: app/Modules/Catalog/Application/Actions/HoldServiceInventoryAction.php
        # Sanctum's currentAccessToken() PHPDoc claims PersonalAccessToken,
        # but at runtime returns TransientToken for cookie auth — runtime guard required
        -
            message: '#Instanceof between Laravel\\Sanctum\\PersonalAccessToken and Laravel\\Sanctum\\PersonalAccessToken will always evaluate to true#'
            path: app/Modules/Identity/Application/Actions/LogoutAction.php
        -
            message: '#Unreachable statement - code above always terminates#'
            path: app/Modules/Identity/Application/Actions/LogoutAction.php
        # Eloquent relationship/factory return types require verbose generics — Larastan level 8 limitation across Booking models
        -
            message: '#(uses|return type with|has parameter .+ with) generic (class|trait) .+ (but does not specify|does not specify) its types#'
            path: app/Modules/Booking/*
        # spatie/laravel-model-states State generic type not inferable without explicit annotation
        -
            message: '#(return type with|extends) generic class Spatie\\ModelStates\\State#'
            path: app/Modules/Booking/*
