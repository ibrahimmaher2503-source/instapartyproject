meta {
  name: Register vendor
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/register/vendor
  body: json
  auth: none
}

headers {
  Accept: application/json
  Accept-Language: en
  Content-Type: application/json
}

body:json {
  {
    "name": "QA Vendor",
    "email": "qa-vendor@example.test",
    "phone_e164": "+201000009999",
    "password": "SafePassword123!",
    "password_confirmation": "SafePassword123!",
    "business_name": {
      "en": "QA Events",
      "ar": "QA Events Arabic"
    },
    "business_type": "individual",
    "primary_governorate_id": 1,
    "facebook_url": "https://www.facebook.com/qa-events",
    "website_url": "https://qa-events.example",
    "instagram_url": "https://www.instagram.com/qa-events",
    "preferred_locale": "en"
  }
}

tests {
  test("registration stays successful while verification is pending", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().meta.registration_successful).to.equal(true);
    expect(res.getBody().meta.verification_pending).to.equal(true);
    expect(res.getBody().data.website_url).to.equal("https://qa-events.example");
    expect(res.getBody().data.primary_city_id).to.equal(null);
  });
}
